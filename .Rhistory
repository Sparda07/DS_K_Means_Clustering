data("NMES1988")
df <- as.data.frame(NMES1988)
str(df)
View(df)
df$visits[sample(1:nrow(df), 1000)] <- NA
df$income[sample(1:nrow(df), 1000)] <- NA
df_removed <- na.omit(df)
View(df)
df_removed <- NA.omit(df)
df_removed <- na.omit(df)
View(df_removed)
View(df)
df$visits[is.na(df$visits)] <- mean(df$visits, na.rm = TRUE)
df$income[is.na(df$income)] <- mean(df$income, na.rm = TRUE)
mode_insurance <- names(sort(table(df$insurance), decreasing = TRUE))[1]
df$insurance[is.na(df$insurance)] <- mode_gender
df$insurance[is.na(df$insurance)] <- mode_insurance
View(df)
df$visits <- df$visits + rnorm(nrow(df), 0, 5)
View(df)
df$insurance[sample(1:nrow(df), 1000)] <- "Unknown"
df$insurance[sample(1:nrow(df), 10)] <- "Unknown"
View(df)
df$health[sample(1:nrow(df), 10)] <- "Unknown"
df$married[sample(1:nrow(df), 10)] <- "Unknown"
levels(df$insurance) <- c(levels(df$insurance), "Unknown")
df$insurance[sample(1:nrow(df), 10)] <- "Unknown"
View(df)
df$insurance[sample(1:nrow(df), 1000)] <- "Unknown"
View(df)
View(df)
df <- df %>% filter(insurance != "Unknown")
df <- df %>% filter(visits > 0)
df <- df %>% mutate(visits = as.numeric(scale(visits)))
ggplot(df, aes(x = visits)) + geom_boxplot()
Q1 <- quantile(df$visits, 0.25)
Q3 <- quantile(df$visits, 0.75)
IQR <- Q3 - Q1
df <- df %>%
filter(visits > (Q1 - 1.5 * IQR) &
visits < (Q3 + 1.5 * IQR))
ggplot(df, aes(x = visits)) + geom_histogram()
ggplot(df, aes(x = insurance)) + geom_bar()
summary(df)
df <- df %>% mutate(employed = ifelse(employed == "yes", 1, 0))
model <- lm(employed ~ distance, data = df)
model <- lm(employed ~ visits, data = df)
summary(model)
set.seed(123)
train_index <- sample(1:nrow(df), 0.8 * nrow(df))
train_data <- df[train_index, ]
test_data  <- df[-train_index, ]
View(df)
